ADMIN_PASSWORD=change-this-password
SESSION_SECRET=change-this-secret
GITHUB_TOKEN=your-github-token
GITHUB_OWNER=billadriang
GITHUB_REPO=saas-landingpage
GITHUB_BRANCH=main

# --- Portfolio AI assistant (chat) ---
# NVIDIA NIM (OpenAI-compatible). Get a key at https://build.nvidia.com
NVIDIA_API_KEY=your-nvidia-api-key
# Optional overrides:
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Generous rate limits; when exceeded the chat falls back to deterministic replies.
CHAT_LLM_PER_IP_PER_HOUR=120
CHAT_LLM_GLOBAL_PER_HOUR=4000

# --- Visitor country counters (durable on Vercel) ---
# Create a Blob store in the Vercel project Storage tab; this token is injected
# automatically when the store is linked. Without it, counts reset on cold starts.
BLOB_READ_WRITE_TOKEN=
